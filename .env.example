# --------------------------------------------------------------------
# Contractly Backend Environment Configuration
# Copy this file to `.env` and fill in real values for your environment.
# --------------------------------------------------------------------

# --- App ---
APP_NAME=Contractly
APP_ENV=development                          # development | production
API_V1_PREFIX=/api/v1
DEBUG=true

# --- MongoDB ---
# Atlas URI or local mongodb instance.
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=contractly

# --- Security / JWT ---
SECRET_KEY=please_change_me_to_a_random_string_min_32_chars_long_xxxxx
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Google OAuth (server-side ID token verification) ---
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-replace-me
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# --- Cloudinary (PDF / signature image storage) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Twilio (optional, for production OTP SMS) ---
# Leave the TWILIO_* values blank in development; OTPs will be logged to console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- CORS ---
# Comma-separated list of allowed origins. Use * during local development.
CORS_ORIGINS=*
